{
  "name": "avtoshahar",
  "private": true,
  "version": "2.0.0",
  "description": "Avtoshahar — O'zbekiston YHQ asosidagi 3D shahar haydash simulyatori (Web / Android / Windows)",
  "author": "Avtodrom",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "uz.avtodrom.avtoshahar",
    "productName": "Avtoshahar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Avtoshahar-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Avtoshahar-${version}-portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "three": "^0.186.1"
  }
}
